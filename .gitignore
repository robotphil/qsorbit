# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Local test fixtures
# Multi-megabyte IQ captures from real hardware. Regenerate with the bench
# scripts rather than committing them; see tests/fixtures/iq/README.md.
tests/fixtures/iq/*.iq
tests/fixtures/iq/*.json

# Bench outputs
# Track logs and motion captures from real runs. These belong beside the
# other bench data in the notes folder, not in the repo -- one was
# committed to main this way (a --track-log path pointed at the repo
# root, and `git add -A` did the rest). Anchored to the root so a
# deliberate fixture deeper in the tree is still possible.
/*.csv
/runs/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
bench-*.toml
